rules_version = '2';
// TEST MODE ONLY: unauthenticated catalog management is intentionally enabled.
service cloud.firestore {
  match /databases/{database}/documents {
    match /look_categories/{categoryId} {
      allow read, create, update, delete: if true;
    }
    match /outfits/{outfitId} {
      allow read, create, update, delete: if true;
    }
    match /experience_ratings/{ratingId} {
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow read, update, delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
