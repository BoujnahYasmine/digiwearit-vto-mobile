rules_version = '2';
// TEST MODE ONLY: unauthenticated outfit image management is intentionally enabled.
service firebase.storage {
  match /b/{bucket}/o {
    match /outfits/{outfitId}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
